# Local dev default (SQLite file, zero setup). For production, point this at a
# real network database (Postgres) — see README "Deploying" section for why
# and how (Neon, Supabase, and Vercel Postgres all work with one env var here).
DATABASE_URL="file:./dev.db"

# Optional shared passcode gate. Leave unset locally to skip auth entirely.
# Set this in production so the app isn't wide open to anyone with the URL.
# APP_PASSCODE="choose-something-only-the-team-knows"
