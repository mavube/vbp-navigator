# Local dev default (SQLite file, zero setup). For production, point this at
# a real network database — a Supabase project's Postgres connection string
# (see below), Neon, or Vercel Postgres all work with this one env var.
DATABASE_URL="file:./dev.db"

# v2.0: real per-user auth + row-level tenant isolation via Supabase.
# Leave all three unset to run locally without Supabase — the app stays
# open (no login required) and uses a single fixed "local-dev" org, same
# zero-setup experience v1.0 had. Set these before deploying anywhere
# reachable by more than one trusted person.
#
# Find these in your Supabase project: Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # server-only — never expose to the browser
